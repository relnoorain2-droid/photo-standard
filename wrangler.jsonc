{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photo-standard",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.1-flash-image"
  }
}
